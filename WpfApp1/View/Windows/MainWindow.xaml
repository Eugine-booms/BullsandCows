<Window x:Class="BullsAndCowsWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BullsAndCowsWPF.ViewModels"
        xmlns:view="clr-namespace:BullsAndCowsWPF.View"
        DataContext="{Binding MainViewModel, Source={StaticResource Locator}}"
        FontFamily="Calibri"
        mc:Ignorable="d"
        Title="Bulls And Cows" Height="600" Width="900">
    <Window.Resources>
    </Window.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Vertical" Width="65" Style="{StaticResource Menu}">
            <StackPanel Style="{StaticResource MenuItem}">
                <ToggleButton x:Name="MenuBtn" IsChecked="True" Margin="8" Width="40" Height="40" 
                              Content="{StaticResource BullImage}"/>
                <TextBlock Text="Меню"/>
            </StackPanel>
            <StackPanel Style="{StaticResource MenuItem}">
                <ToggleButton IsChecked="{Binding IsGameViewActive, Mode=OneWay}" Command="{Binding ShowGameViewCommand}" 
                              Content="{StaticResource LoveImage}" />
                <TextBlock Text="Игра" />
            </StackPanel>
            <StackPanel Style="{StaticResource MenuItem}">
                <ToggleButton IsChecked="{Binding IsSettingsViewActive, Mode=OneWay}" Command="{Binding ShowSettingsViewCommand}" 
                              Content="{StaticResource SweatingImage}"/>
                <TextBlock Text="Настройки" />
            </StackPanel>
            <StackPanel Style="{StaticResource MenuItem}">
                <Button Content="{StaticResource SadImage}" Command="{StaticResource CloseCommand}"/>
                <TextBlock Text="Выход"/>
            </StackPanel>
        </StackPanel>
        <GroupBox Grid.Column="1" Grid.RowSpan="4" >
            <GroupBox.Header >
                <TextBlock FontFamily="Teddy Bear" 
                           TextWrapping="Wrap" 
                            FontSize="20" FontWeight="Bold" Text="Игровое поле">
                   
                </TextBlock>
            </GroupBox.Header>
            <ContentControl Content="{Binding CurrentViewModel}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:GameViewModel}">
                        <view:GameView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                        <view:SettingsView/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </GroupBox>
    </DockPanel>
</Window>
